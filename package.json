{
  "name": "pongdang-island",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:verify": "node scripts/db/verify.mjs && node scripts/db/context.mjs check",
    "db:context": "node scripts/db/context.mjs write",
    "db:remote": "node scripts/db/context.mjs remote",
    "db:catalog": "node scripts/db/catalog.mjs",
    "storage:upload": "node scripts/upload-collectibles.mjs",
    "images:optimize": "node scripts/optimize-png-lossless.mjs",
    "test": "vitest run",
    "test:arcade:ui": "vitest run tests/arcade.test.tsx tests/game-layout.test.tsx tests/game-modal.test.tsx tests/brick-breaker-ui.test.tsx tests/brick-touch-controls.test.tsx tests/memory-game-ui.test.tsx tests/shadow-game-ui.test.tsx tests/odd-even-ui.test.tsx tests/ladder-ui.test.tsx",
    "format:arcade": "prettier --write \"src/features/arcade/**/*.{ts,tsx,css}\"",
    "format:arcade:check": "prettier --check \"src/features/arcade/**/*.{ts,tsx,css}\"",
    "dev": "vite",
    "titles:generate": "node scripts/build-title-tiers.mjs",
    "build": "node scripts/build-title-tiers.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "arcade:engine": "node scripts/build-brick-replay.mjs",
    "arcade:engine:check": "node scripts/build-brick-replay.mjs --check",
    "images:thumbnails": "node scripts/build-collectible-thumbnails.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
